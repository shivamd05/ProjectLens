# Optional hosted evaluation providers. Gemini is tried first, then OpenAI, matching FastAPI.
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini

# MySQL 8+ connection. Create the database once; Flyway creates the application tables.
DATABASE_URL=jdbc:mysql://localhost:3306/projectlense?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=Shivam94@mysql

# Set a long random value before using the admin import endpoints.
PROJECTLENSE_ADMIN_TOKEN=projectlense-admin-2026-private-key
EMBEDDING_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.78
SIMILARITY_RESULT_LIMIT=5

# Defaults preserve the existing React API port and upload folder.
SERVER_PORT=8000
UPLOAD_DIR=../backend/uploads
EXTRACT_DIR=../backend/extracted_projects
MAX_UPLOAD_SIZE=100MB
